{
  "name": "server",
  "version": "1.0.0",
  "description": "CommerceHub backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts src/modules/reviews/review-rules.test.ts src/modules/shipping/shipping-ruler.test.ts",
    "test:security": "tsx --test tests/security.test.ts",
    "migrate:payments:dry-run": "tsx src/scripts/migrate-payments.ts",
    "migrate:payments": "tsx src/scripts/migrate-payments.ts --apply",
    "test:reviews": "tsx --test src/modules/reviews/review-rules.test.ts",
    "reviews:indexes": "tsx src/modules/reviews/review-indexes.ts",
    "test:coupons": "tsx --test tests/coupons-errors.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
