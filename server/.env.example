NODE_ENV=development
SERVE_FRONTEND=false
# Production on Render derives PUBLIC_APP_URL/CORS_ORIGINS from RENDER_EXTERNAL_URL if unset.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/commercehub?replicaSet=rs0
# Generate a random secret containing at least 32 bytes; do not commit real secrets.
JWT_ACCESS_SECRET=
# Exact frontend origins, comma separated. Empty disables cross-origin browser access.
CORS_ORIGINS=http://localhost:5173
# Optional: actual reverse proxy IP addresses/CIDRs. Leave empty for direct connections.
TRUSTED_PROXIES=

# Email delivery is disabled until a verified sender and provider credentials exist.
PUBLIC_APP_URL=http://127.0.0.1:5173
MAIL_TRANSPORT=disabled
MAIL_FROM=
RESEND_API_KEY=
# Free hosting: MAIL_TRANSPORT=gmail-api uses Google Cloud OAuth and HTTPS.
# MAIL_FROM="BerylCore <your-email@gmail.com>" must match GMAIL_USER.
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# EMAIL_TEST_TO=your-email@gmail.com (optional; only used by email:test)
# Optional alternative adapter:
BREVO_API_KEY=
# Gmail demo: MAIL_TRANSPORT=smtp, MAIL_FROM="BerylCore <your-email@gmail.com>"
# App password only. Never use the normal Google account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Production requires verification by default; development permits unverified accounts.
# EMAIL_VERIFICATION_REQUIRED=true
# Uploaded product images must be kept on persistent storage and backed up.
# UPLOAD_DIRECTORY=D:/CommerceHub/server/var/uploads
# Use gridfs on ephemeral hosting. Existing URLs stay /api/media/<uuid>.<ext>.
UPLOAD_STORAGE=local

# Legacy VNPAY support for old orders. New checkout uses SePay below.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://127.0.0.1:5173/payments/vnpay/return
# Register https://<public-backend>/api/payments/vnpay/ipn in VNPAY merchant settings.

# SePay PAYMENT GATEWAY sandbox (not Bank Hub or balance webhooks).
SEPAY_ENABLED=false
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# Set independently in SePay > Payment Gateway > Configuration > IPN > SECRET_KEY auth.
# Use a random secret of at least 32 bytes; do not reuse your merchant secret.
SEPAY_IPN_SECRET=
SEPAY_RETURN_URL=http://127.0.0.1:5173/payments/sepay/return
# Register https://<public-backend>/api/payments/sepay/ipn as the gateway IPN URL.

# sandbox or production; production requires HTTPS public callback and live credentials
SEPAY_ENV=sandbox

# GHN Staging only. No real deliveries. Use credentials from the GHN test account.
GHN_ENABLED=false
GHN_ENV=staging
GHN_TOKEN=
GHN_SHOP_ID=
