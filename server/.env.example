NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/commercehub?replicaSet=rs0
# Generate a random secret containing at least 32 bytes; do not commit real secrets.
JWT_ACCESS_SECRET=
# Exact frontend origins, comma separated. Empty disables cross-origin browser access.
CORS_ORIGINS=http://localhost:5173
# Optional: actual reverse proxy IP addresses/CIDRs. Leave empty for direct connections.
TRUSTED_PROXIES=
